# All values are intentionally empty. Copy only to a protected owner-only file.
# PAN/CVC belong only in the separately encrypted owner vault, never in this file.
CRYPTO_BOT_TOKEN=
CRYPTO_EXPECTED_BOT_ID=
CRYPTO_EXPECTED_BOT_USERNAME=
CRYPTO_RECEIVING_ADDRESS=
CRYPTO_NETWORK=
BINANCE_READ_API_KEY=
BINANCE_READ_API_SECRET=
TRONGRID_API_KEY=
CRYPTO_DATA_DIR=
CRYPTO_STORE_SESSION_FILE=
CRYPTO_STORE_BINDING_PROOF_FILE=
CRYPTO_STORE_REGION=
CRYPTO_CARD_VAULT_FILE=
CRYPTO_CARD_KEY_FILE=
CRYPTO_STRIPE_PUBLISHABLE_KEY=
CRYPTO_BROWSER_EXECUTABLE=
# Empty binding policy means strict. sha256_marker additionally requires the
# explicit first-live-validation authorization below; actual order proof is mandatory.
CRYPTO_BINDING_POLICY=
CRYPTO_ALLOW_FIRST_LIVE_VALIDATION=
# Empty flags mean false. Never enable merely to make the check pass.
CRYPTO_STORE_CREATES_ENABLED=
CRYPTO_LIVE_PURCHASES_ENABLED=
CRYPTO_ALLOW_UNIQUE_CENT_AMOUNTS=
CRYPTO_EXCLUSIVE_POLLER_CONFIRMED=
