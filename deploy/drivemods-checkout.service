# Prepared only. Do not enable before verified payment/device binding and a
# separately reviewed cutover. This unit never stops the existing bot.
[Unit]
Description=DriveMods crypto checkout - verified production assembly
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/drivemods-checkout.env
ConditionPathExists=/etc/drivemods-checkout-session.json

[Service]
Type=simple
User=drivemods-checkout
Group=drivemods-checkout
WorkingDirectory=/opt/drivemods-checkout
LoadCredential=app.env:/etc/drivemods-checkout.env
LoadCredential=store-session.json:/etc/drivemods-checkout-session.json
# Optional: uncomment only after the owner approved and installed both protected files.
# LoadCredential=owner-card.enc:/etc/drivemods-checkout-owner-card.enc
# LoadCredential=owner-card.key:/etc/drivemods-checkout-owner-card.key
Environment=CRYPTO_DATA_DIR=/var/lib/drivemods-checkout
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUTF8=1
# Unknown/starting/stopping/active previous-service state blocks the new unit.
# No Conflicts= dependency: an attempted start must not stop the working bot.
ExecCondition=/bin/sh -c 'case "$$(/usr/bin/systemctl show -p ActiveState --value drivemods-license-bot.service)" in inactive|failed) exit 0;; *) exit 1;; esac'
# systemd 249 provides CREDENTIALS_DIRECTORY but does not support the later %d
# specifier. Double dollars pass the variable through to this explicit shell.
# On the deployed systemd 249, credentials are accessible in ExecStart but not
# ExecStartPre. application --run performs the full read-only/browser preflight
# before opening a ledger or starting a Telegram poller.
ExecStart=/bin/sh -c 'export CRYPTO_STORE_SESSION_FILE="$$CREDENTIALS_DIRECTORY/store-session.json"; exec /opt/drivemods-checkout/.venv/bin/python -m crypto_checkout.application --run --env-file "$$CREDENTIALS_DIRECTORY/app.env"'
Restart=on-failure
RestartSec=30
TimeoutStartSec=180
TimeoutStopSec=40
UMask=0077
LimitCORE=0
StateDirectory=drivemods-checkout
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
BindReadOnlyPaths=/etc/drivemods-checkout.hosts:/etc/hosts
ReadWritePaths=/var/lib/drivemods-checkout
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
