[Unit]
Description=DriveMods read-only TRON USDT observer - no purchases
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=drivemods-crypto
Group=drivemods-crypto
WorkingDirectory=/opt/drivemods-crypto-observer
EnvironmentFile=/etc/drivemods-crypto-observer.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUTF8=1
ExecStart=/opt/drivemods-license-bot/.venv/bin/python -m crypto_checkout.observer
Restart=always
RestartSec=30
UMask=0077
StateDirectory=drivemods-crypto-observer
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/drivemods-crypto-observer
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
