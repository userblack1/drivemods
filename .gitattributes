# Store portable text in LF, restore Windows launchers as CRLF on checkout.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.lock text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
